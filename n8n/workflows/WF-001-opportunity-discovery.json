{
  "name": "WF-001 Opportunity Discovery",
  "nodes": [
    {
      "id": "trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */4 * * *"
            }
          ]
        }
      },
      "notes": "Every 4 hours."
    },
    {
      "id": "check_idempotency",
      "name": "Check Idempotency",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        280,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id FROM workflow_runs WHERE workflow_code = 'WF-001' AND idempotency_key = $1 AND status = 'SUCCESS'",
        "queryReplacement": "={{ [$now.toFormat('yyyy-LL-dd-HH')] }}"
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER_POSTGRES_CRED",
          "name": "Barray Postgres"
        }
      },
      "notes": "Idempotency: skips if this workflow already succeeded for this key (see workflow_runs unique index)."
    },
    {
      "id": "if_already_run",
      "name": "IF Already Run",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        560,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "stop_already_run",
      "name": "Stop (Already Processed)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        840,
        180
      ],
      "parameters": {}
    },
    {
      "id": "start_run",
      "name": "Start Workflow Run",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        840,
        420
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_runs (workflow_code, idempotency_key, entity, status) VALUES ('WF-001', $1, 'opportunity', 'RUNNING') RETURNING id",
        "queryReplacement": "={{ [$now.toFormat('yyyy-LL-dd-HH')] }}"
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER_POSTGRES_CRED",
          "name": "Barray Postgres"
        }
      }
    },
    {
      "id": "main_logic",
      "name": "Discover New Listings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        420
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_BASE_URL }}/api/internal/sourcing/discover",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\"brand\":\"SITRAK\",\"models\":[\"C7H\",\"G7\",\"C9H\"],\"configurations\":[\"8x4\"]} }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER_DASHBOARD_API_CRED",
          "name": "Barray Dashboard API"
        }
      },
      "continueOnFail": true,
      "notes": "Calls the internal dashboard API endpoint /api/internal/sourcing/discover, which applies deterministic @barray/shared logic and writes Postgres. n8n does not compute business rules itself."
    },
    {
      "id": "persist_result",
      "name": "Persist Result",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1400,
        420
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO audit_logs (action, entity, entity_id, new_value, workflow_id) VALUES ('OPPORTUNITY_DISCOVERY_RUN', 'opportunity', $1, $2, 'WF-001')",
        "queryReplacement": "={{ [$json.entityId ?? $json.id ?? null, JSON.stringify($json)] }}"
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER_POSTGRES_CRED",
          "name": "Barray Postgres"
        }
      },
      "continueOnFail": true
    },
    {
      "id": "finish_run",
      "name": "Record Success",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1680,
        420
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE workflow_runs SET status = 'SUCCESS', finished_at = now() WHERE workflow_code = 'WF-001' AND idempotency_key = $1",
        "queryReplacement": "={{ [$now.toFormat('yyyy-LL-dd-HH')] }}"
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER_POSTGRES_CRED",
          "name": "Barray Postgres"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Check Idempotency",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Idempotency": {
      "main": [
        [
          {
            "node": "IF Already Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Already Run": {
      "main": [
        [
          {
            "node": "Stop (Already Processed)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Start Workflow Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start Workflow Run": {
      "main": [
        [
          {
            "node": "Discover New Listings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Discover New Listings": {
      "main": [
        [
          {
            "node": "Persist Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Persist Result": {
      "main": [
        [
          {
            "node": "Record Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "WF-027-error-handler",
    "saveManualExecutions": true,
    "saveExecutionProgress": true
  },
  "meta": {
    "barrayWorkflowCode": "WF-001",
    "description": "Polls configured sourcing providers (Alibaba, Made-in-China, approved feeds) for new SITRAK listings and inserts them as opportunities in DISCOVERED status.",
    "requiredCredentials": [
      "Barray Dashboard API (HTTP Header Auth)",
      "Barray Postgres"
    ]
  }
}

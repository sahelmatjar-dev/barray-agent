{
  "name": "WF-018 Freight RFQ",
  "nodes": [
    {
      "id": "trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "path": "freight-rfq-send",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      },
      "notes": "Called once packing is complete for a donor truck."
    },
    {
      "id": "check_idempotency",
      "name": "Check Idempotency",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        280,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id FROM workflow_runs WHERE workflow_code = 'WF-018' AND idempotency_key = $1 AND status = 'SUCCESS'",
        "queryReplacement": "={{ [$json.donorId] }}"
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER_POSTGRES_CRED",
          "name": "Barray Postgres"
        }
      },
      "notes": "Idempotency: skips if this workflow already succeeded for this key (see workflow_runs unique index)."
    },
    {
      "id": "if_already_run",
      "name": "IF Already Run",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        560,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "stop_already_run",
      "name": "Stop (Already Processed)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        840,
        180
      ],
      "parameters": {}
    },
    {
      "id": "start_run",
      "name": "Start Workflow Run",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        840,
        420
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_runs (workflow_code, idempotency_key, entity, status) VALUES ('WF-018', $1, 'freight_quote', 'RUNNING') RETURNING id",
        "queryReplacement": "={{ [$json.donorId] }}"
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER_POSTGRES_CRED",
          "name": "Barray Postgres"
        }
      }
    },
    {
      "id": "main_logic",
      "name": "Send Freight RFQ Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1120,
        420
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "to": "={{ $json.forwarderEmail }}",
        "subject": "={{ 'Freight RFQ - ' + $json.donorCode }}",
        "message": "={{ $json.freightRfqBodyHtml }}",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "PLACEHOLDER_GMAIL_CRED",
          "name": "Barray Gmail"
        }
      },
      "continueOnFail": true,
      "notes": "Routes covered: Qingdao/Shanghai/Ningbo to Tanger Med/Casablanca; container types 20GP/40GP/40HQ/Flat Rack/Open Top/LCL/Break Bulk."
    },
    {
      "id": "persist_result",
      "name": "Persist Result",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1400,
        420
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO audit_logs (action, entity, entity_id, new_value, workflow_id) VALUES ('FREIGHT_RFQ_SENT', 'freight_quote', $1, $2, 'WF-018')",
        "queryReplacement": "={{ [$json.entityId ?? $json.id ?? null, JSON.stringify($json)] }}"
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER_POSTGRES_CRED",
          "name": "Barray Postgres"
        }
      },
      "continueOnFail": true
    },
    {
      "id": "finish_run",
      "name": "Record Success",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1680,
        420
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE workflow_runs SET status = 'SUCCESS', finished_at = now() WHERE workflow_code = 'WF-018' AND idempotency_key = $1",
        "queryReplacement": "={{ [$json.donorId] }}"
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER_POSTGRES_CRED",
          "name": "Barray Postgres"
        }
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Check Idempotency",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Idempotency": {
      "main": [
        [
          {
            "node": "IF Already Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Already Run": {
      "main": [
        [
          {
            "node": "Stop (Already Processed)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Start Workflow Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start Workflow Run": {
      "main": [
        [
          {
            "node": "Send Freight RFQ Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Freight RFQ Email": {
      "main": [
        [
          {
            "node": "Persist Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Persist Result": {
      "main": [
        [
          {
            "node": "Record Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "WF-027-error-handler",
    "saveManualExecutions": true,
    "saveExecutionProgress": true
  },
  "meta": {
    "barrayWorkflowCode": "WF-018",
    "description": "Sends freight rate requests (route, container type, cargo details) to the configured freight forwarders for a donor truck's packages.",
    "requiredCredentials": [
      "Barray Gmail (OAuth2)"
    ]
  }
}

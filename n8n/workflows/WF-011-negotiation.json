{
  "name": "WF-011 Negotiation Draft",
  "nodes": [
    {
      "id": "trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "path": "negotiation-draft",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      },
      "notes": "Called when a negotiation moves to the next round."
    },
    {
      "id": "check_idempotency",
      "name": "Check Idempotency",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        280,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id FROM workflow_runs WHERE workflow_code = 'WF-011' AND idempotency_key = $1 AND status = 'SUCCESS'",
        "queryReplacement": "={{ [$json.negotiationId + '-' + $now.toFormat('yyyy-LL-dd-HH-mm')] }}"
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER_POSTGRES_CRED",
          "name": "Barray Postgres"
        }
      },
      "notes": "Idempotency: skips if this workflow already succeeded for this key (see workflow_runs unique index)."
    },
    {
      "id": "if_already_run",
      "name": "IF Already Run",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        560,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "stop_already_run",
      "name": "Stop (Already Processed)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        840,
        180
      ],
      "parameters": {}
    },
    {
      "id": "start_run",
      "name": "Start Workflow Run",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        840,
        420
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_runs (workflow_code, idempotency_key, entity, status) VALUES ('WF-011', $1, 'negotiation', 'RUNNING') RETURNING id",
        "queryReplacement": "={{ [$json.negotiationId + '-' + $now.toFormat('yyyy-LL-dd-HH-mm')] }}"
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER_POSTGRES_CRED",
          "name": "Barray Postgres"
        }
      }
    },
    {
      "id": "main_logic",
      "name": "Draft Negotiation Message (AI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        420
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_BASE_URL }}/api/internal/negotiations/draft",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\"negotiationId\": $json.negotiationId} }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER_DASHBOARD_API_CRED",
          "name": "Barray Dashboard API"
        }
      },
      "continueOnFail": true,
      "notes": "Calls the internal dashboard API endpoint /api/internal/negotiations/draft, which applies deterministic @barray/shared logic and writes Postgres. n8n does not compute business rules itself."
    },
    {
      "id": "persist_result",
      "name": "Persist Result",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1400,
        420
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO audit_logs (action, entity, entity_id, new_value, workflow_id) VALUES ('NEGOTIATION_DRAFTED', 'negotiation', $1, $2, 'WF-011')",
        "queryReplacement": "={{ [$json.entityId ?? $json.id ?? null, JSON.stringify($json)] }}"
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER_POSTGRES_CRED",
          "name": "Barray Postgres"
        }
      },
      "continueOnFail": true
    },
    {
      "id": "finish_run",
      "name": "Record Success",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1680,
        420
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE workflow_runs SET status = 'SUCCESS', finished_at = now() WHERE workflow_code = 'WF-011' AND idempotency_key = $1",
        "queryReplacement": "={{ [$json.negotiationId + '-' + $now.toFormat('yyyy-LL-dd-HH-mm')] }}"
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER_POSTGRES_CRED",
          "name": "Barray Postgres"
        }
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Check Idempotency",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Idempotency": {
      "main": [
        [
          {
            "node": "IF Already Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Already Run": {
      "main": [
        [
          {
            "node": "Stop (Already Processed)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Start Workflow Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start Workflow Run": {
      "main": [
        [
          {
            "node": "Draft Negotiation Message (AI)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Draft Negotiation Message (AI)": {
      "main": [
        [
          {
            "node": "Persist Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Persist Result": {
      "main": [
        [
          {
            "node": "Record Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "WF-027-error-handler",
    "saveManualExecutions": true,
    "saveExecutionProgress": true
  },
  "meta": {
    "barrayWorkflowCode": "WF-011",
    "description": "Drafts a negotiation counter-offer email via AI within [ideal_price, maximum_price]. Never sends automatically — the draft is stored as PENDING_APPROVAL for a human to review and send.",
    "requiredCredentials": [
      "Barray Dashboard API (HTTP Header Auth)",
      "Barray Postgres"
    ]
  }
}

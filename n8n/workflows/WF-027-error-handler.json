{
  "name": "WF-027 Error Handler",
  "nodes": [
    {
      "id": "trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {}
    },
    {
      "id": "log_failure",
      "name": "Log Failed Execution",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        280,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE workflow_runs SET status = 'FAILED', error = $1, finished_at = now() WHERE n8n_execution_id = $2",
        "options": {},
        "queryReplacement": "={{ [$json.execution.error?.message ?? 'unknown error', $json.execution.id] }}"
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER_POSTGRES_CRED",
          "name": "Barray Postgres"
        }
      }
    },
    {
      "id": "alert_owner",
      "name": "Alert Owner (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        560,
        300
      ],
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_OWNER_CHAT_ID }}",
        "text": "=⚠️ n8n workflow failed: {{ $json.workflow.name }} — {{ $json.execution.error?.message }}",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "PLACEHOLDER_TELEGRAM_CRED",
          "name": "Barray Telegram"
        }
      }
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Log Failed Execution",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Failed Execution": {
      "main": [
        [
          {
            "node": "Alert Owner (Telegram)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "WF-027-error-handler",
    "saveManualExecutions": true,
    "saveExecutionProgress": true
  },
  "meta": {
    "barrayWorkflowCode": "WF-027",
    "description": "Shared error-handling workflow: every other workflow's Settings > Error Workflow points here. Logs the failure to workflow_runs and alerts the owner via Telegram immediately.",
    "requiredCredentials": []
  }
}

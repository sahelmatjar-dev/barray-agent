# =============================================================================
# EL BARRAY RA — SITRAK China Sourcing OS — environment configuration
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# ---- Database ---------------------------------------------------------------
POSTGRES_USER=barray
POSTGRES_PASSWORD=change-me
POSTGRES_DB=barray_sourcing
# Full connection string used by the dashboard, scripts, and the migrate service.
# In Docker Compose this points at the `postgres` service; for local dev without
# Docker, point it at localhost.
DATABASE_URL=postgresql://barray:change-me@localhost:5432/barray_sourcing

# ---- n8n ----------------------------------------------------------------------
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
# Generate with: openssl rand -hex 32
# Losing this key makes existing n8n credentials unrecoverable — back it up (see README "Backups").
N8N_ENCRYPTION_KEY=
# n8n's editor must never be exposed publicly without auth. Basic auth is enabled by default in docker-compose.yml.
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# ---- Dashboard session / auth -------------------------------------------------
# REQUIRED, at least 32 characters — the app refuses to start signing/verifying
# sessions without it (no insecure default). Generate with: openssl rand -hex 32
SESSION_SECRET=
APP_BASE_URL=http://localhost:3000
# Bearer token n8n uses to call apps/dashboard's /api/internal/* endpoints.
# Generate with: openssl rand -hex 32 — this is the "Barray Dashboard API"
# HTTP Header Auth credential referenced by n8n workflow nodes.
INTERNAL_API_TOKEN=

# ---- AI provider abstraction (packages/ai) ------------------------------------
# "anthropic" or "openai" — see packages/ai/src/factory.ts
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ---- Google OAuth (Gmail + Drive) ---------------------------------------------
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console with
# scopes: gmail.send, gmail.readonly, drive.file. See README "Google OAuth setup".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---- Telegram (owner alerts) ---------------------------------------------------
# Create a bot via @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ---- Sourcing connectors (packages/integrations/src/sourcing) ------------------
# Optional. Until configured, these providers throw IntegrationNotConfiguredError
# and WF-001 falls back to MANUAL listing entry only.
ALIBABA_API_KEY=
MADE_IN_CHINA_API_KEY=

# ---- Redis (n8n queue mode + short-lived AI response cache) --------------------
REDIS_URL=redis://localhost:6379

# ---- Misc -----------------------------------------------------------------------
TZ=Africa/Casablanca
NODE_ENV=development
